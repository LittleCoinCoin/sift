{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "../package.json",
  "identifier": "dev.eliottjacopin.sift",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sift",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' data: blob: receipt://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "resources": ["libpdfium.dylib"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LittleCoinCoin/sift/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4ODREQzUzNzYzMDAzNzYKUldSMkF6QjJVOXlFR0NlNFJmd09wdHVtL3I5cXQ1ZEw5ajBndEFyUVplRlNPbHV2MGJpVUVFL3YK"
    }
  }
}
